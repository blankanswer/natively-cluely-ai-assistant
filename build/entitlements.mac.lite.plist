<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Natively Lite CN: top-level Developer ID / Hardened Runtime entitlements. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>

    <!--
      Intentionally no keychain-access-groups entitlement.
      The packaged Lite macOS flavor uses the app-managed encrypted credential
      fallback rather than Electron safeStorage, so it does not need a restricted
      keychain entitlement or provisioning profile. Keeping this profile free of
      restricted capabilities makes Developer ID signing/notarization deterministic
      for the dedicated com.blankanswer.natively-lite-cn bundle identity.
    -->
</dict>
</plist>
